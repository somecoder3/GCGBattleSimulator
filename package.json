{
  "name": "gcg-battle-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Battle simulator and AI for the Gundam Card Game",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "tsx tools/images.ts",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build",
    "sim": "tsx tools/sim.ts",
    "fuzz": "tsx tools/sim.ts --check --games 100000",
    "coverage": "tsx tools/coverage.ts",
    "meta": "tsx tools/meta-snapshot.ts",
    "game": "tsx tools/game-log.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
